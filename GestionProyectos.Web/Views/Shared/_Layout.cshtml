@{
    var token = Context.Session.GetString(SesionKeys.Token);
    var nombre = Context.Session.GetString(SesionKeys.Nombre);
    var rol = Context.Session.GetString(SesionKeys.Rol);
    var esAdministrador = rol == SesionKeys.RolAdministrador;
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    string Activo(params string[] nombres) => nombres.Contains(controlador) ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Bitácora</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!string.IsNullOrEmpty(token))
    {
        <div class="app">
            <aside class="lateral">
                <a class="marca" asp-controller="Dashboard" asp-action="Index">
                    <span class="marca__sello">b</span>
                    <span class="marca__nombre">Bitácora<small>Gestión de proyectos</small></span>
                </a>

                <div class="lateral__titulo">Espacio de trabajo</div>
                <ul class="menu">
                    <li>
                        <a asp-controller="Dashboard" asp-action="Index" class="@Activo("Dashboard")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                            Resumen
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Proyectos" asp-action="Index" class="@Activo("Proyectos", "Tareas")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>
                            Proyectos
                        </a>
                    </li>
                    @if (esAdministrador)
                    {
                        <li>
                            <a asp-controller="Usuarios" asp-action="Index" class="@Activo("Usuarios")">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.5 3.5 5.2" /></svg>
                                Equipo
                            </a>
                        </li>
                    }
                </ul>

                <div class="lateral__pie">
                    <div class="usuario-actual">
                        <span class="avatar avatar--lg avatar--@UiHelpers.TonoAvatar(nombre)">@UiHelpers.Iniciales(nombre)</span>
                        <div>
                            <div class="usuario-actual__nombre">@nombre</div>
                            <div class="usuario-actual__rol">@rol</div>
                        </div>
                    </div>
                    <form asp-controller="Cuenta" asp-action="Logout" method="post">
                        <button type="submit" class="btn-salir" title="Cerrar sesión">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="M10 8l-4 4 4 4M6 12h10" /></svg>
                            <span>Cerrar sesión</span>
                        </button>
                    </form>
                </div>
            </aside>

            <main class="contenido">
                @if (TempData["Exito"] is string exito)
                {
                    <div class="aviso aviso--exito" role="status">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9.5" /></svg>
                        @exito
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="aviso aviso--error" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5h.01" /></svg>
                        @error
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }
</body>
</html>
