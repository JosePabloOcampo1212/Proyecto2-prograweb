@model string
@{
    ViewData["Title"] = "Error";
}
<div class="panel vacio" style="max-width:560px;margin:40px auto">
    <div class="vacio__icono" style="border-color:var(--rojo);color:var(--rojo)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5M12 16.5h.01" /><path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
    </div>
    <h1 class="vacio__titulo">Algo salió mal</h1>
    <p>@Model</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secundario">Volver al resumen</a>
</div>
