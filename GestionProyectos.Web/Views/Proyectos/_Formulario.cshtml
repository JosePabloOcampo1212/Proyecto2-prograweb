@model ProyectoFormViewModel
<form asp-action="@(Model.Id == 0 ? "Crear" : "Editar")" method="post" class="formulario">
    <input type="hidden" asp-for="Id" />
    <div class="panel panel__cuerpo">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="separador">General</div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Rediseño del sitio web" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="¿De qué se trata este proyecto?"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="separador">Fechas</div>
        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="FechaInicio" class="form-label"></label>
                <input asp-for="FechaInicio" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="FechaFinEstimada" class="form-label"></label>
                <input asp-for="FechaFinEstimada" class="form-control" />
                <span asp-validation-for="FechaFinEstimada" class="text-danger"></span>
            </div>
        </div>

        <div class="separador">Seguimiento</div>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label asp-for="IdEstado" class="form-label"></label>
                <select asp-for="IdEstado" class="form-select" asp-items="@(new SelectList(Model.Estados, "Id", "Nombre"))">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="IdEstado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-2">
                <label asp-for="IdResponsable" class="form-label"></label>
                <select asp-for="IdResponsable" class="form-select" asp-items="@(new SelectList(Model.Responsables, "Id", "Nombre"))">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="IdResponsable" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-pie">
        <button type="submit" class="btn btn-primary">Guardar proyecto</button>
        <a asp-action="Index" class="btn btn-fantasma">Cancelar</a>
    </div>
</form>
