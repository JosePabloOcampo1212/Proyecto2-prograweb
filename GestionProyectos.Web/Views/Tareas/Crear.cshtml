@model TareaFormViewModel
@{
    ViewData["Title"] = "Nueva tarea";
}
<header class="encabezado">
    <div>
        <div class="antetitulo"><a asp-action="Index" asp-route-idProyecto="@Model.IdProyecto">@Model.NombreProyecto</a></div>
        <h1 class="titulo">Nueva <em>tarea</em></h1>
        <p class="subtitulo">Describa qué hay que hacer, quién lo hará y para cuándo.</p>
    </div>
</header>

<form asp-action="Crear" method="post" class="formulario">
    <input type="hidden" asp-for="IdProyecto" />
    <div class="panel panel__cuerpo">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="separador">Qué</div>
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" placeholder="Ej. Preparar la maqueta de la portada" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalles, criterios de aceptación, enlaces..."></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="separador">Quién y cuándo</div>
        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="IdAsignado" class="form-label"></label>
                <select asp-for="IdAsignado" class="form-select" asp-items="@(new SelectList(Model.Usuarios, "Id", "Nombre"))">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="IdAsignado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="FechaVencimiento" class="form-label"></label>
                <input asp-for="FechaVencimiento" class="form-control" />
                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
            </div>
        </div>

        <div class="separador">Seguimiento</div>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label asp-for="IdEstado" class="form-label"></label>
                <select asp-for="IdEstado" class="form-select" asp-items="@(new SelectList(Model.Estados, "Id", "Nombre"))">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="IdEstado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-2">
                <label asp-for="IdPrioridad" class="form-label"></label>
                <select asp-for="IdPrioridad" class="form-select" asp-items="@(new SelectList(Model.Prioridades, "Id", "Nombre"))">
                    <option value="0">Seleccione...</option>
                </select>
                <span asp-validation-for="IdPrioridad" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-pie">
        <button type="submit" class="btn btn-primary">Crear tarea</button>
        <a asp-action="Index" asp-route-idProyecto="@Model.IdProyecto" class="btn btn-fantasma">Cancelar</a>
    </div>
</form>
